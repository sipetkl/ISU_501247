# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#140808"

# Main text color
theme[main_fg]="#c4c1c1"

# Title color for boxes
theme[title]="#c4c1c1"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#B3BA3B"

# Background color of selected item in processes box
theme[selected_bg]="#F3CC20"

# Foreground color of selected item in processes box
theme[selected_fg]="#c4c1c1"

# Color of inactive/disabled text
theme[inactive_fg]="#939090"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#c4c1c1"

# Background color of the percentage meters
theme[meter_bg]="#2d1616"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#EBA729"

# Cpu box outline color
theme[cpu_box]="#FAE70E"

# Memory/disks box outline color
theme[mem_box]="#EC9B69"

# Net up/down box outline color
theme[net_box]="#EBA729"

# Processes box outline color
theme[proc_box]="#D272CA"

# Box divider line and small boxes line color
theme[div_line]="#433939"

# Temperature graph colors
theme[temp_start]="#FAE70E"
theme[temp_mid]="#EC9B69"
theme[temp_end]="#D272CA"

# CPU graph colors
theme[cpu_start]="#FAE70E"
theme[cpu_mid]="#EC9B69"
theme[cpu_end]="#D272CA"

# Mem/Disk free meter
theme[free_start]="#FAE70E"
theme[free_mid]="#EC9B69"
theme[free_end]="#D272CA"

# Mem/Disk cached meter
theme[cached_start]="#FAE70E"
theme[cached_mid]="#EC9B69"
theme[cached_end]="#D272CA"

# Mem/Disk available meter
theme[available_start]="#FAE70E"
theme[available_mid]="#EC9B69"
theme[available_end]="#D272CA"

# Mem/Disk used meter
theme[used_start]="#FAE70E"
theme[used_mid]="#EC9B69"
theme[used_end]="#D272CA"

# Download graph colors
theme[download_start]="#FAE70E"
theme[download_mid]="#EC9B69"
theme[download_end]="#D272CA"

# Upload graph colors
theme[upload_start]="#FAE70E"
theme[upload_mid]="#EC9B69"
theme[upload_end]="#D272CA"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#FAE70E"
theme[process_mid]="#EC9B69"
theme[process_end]="#D272CA"
