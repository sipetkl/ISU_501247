{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#14080890",
                "editor.background": "#14080890",
                "editor.foreground": "#c4c1c1",
                "text": "#c4c1c1",
                "text.muted": "#c4c1c170",
                "text.ignored": "#c4c1c140",
                "text.placeholder": "#c4c1c150",
                "ignored": "#c4c1c130",
                "element.hover": "#c4c1c130",
                "ghost_element.hover": "#B3BA3B30",
                "ghost_element.selected": "#B3BA3B30",
                "ghost_element.active": "#B3BA3B60",
                "border": "#140808",
                "editor.highlighted_line.background": "#B3BA3B10",
                "editor.active_line.background": "#B3BA3B10",
                "panel.background": "#14080890",
                "title_bar.background": "#14080890",
                "title_bar.inactive_background": "#14080890",
                "status_bar.background": "#14080890",
                "drop_target.background": "#14080890",
                "elevated_surface.background": "#140808",
                "toolbar.background": "#14080890",
                "tab_bar.background": "#14080890",
                "tab.inactive_background": "#14080890",
                "tab.active_background": "#B3BA3B30",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#140808",
                "scrollbar.thumb.background": "#B3BA3B",
                "editor.gutter.background": "#14080890",
                "terminal.background": "#14080810",
                "terminal.foreground": "#c4c1c1",
                "terminal.dim_foreground": "#c4c1c1",
                "terminal.bright_foreground": "#c4c1c1",
                "terminal.ansi.black": "#140808",
                "terminal.ansi.red": "#B3BA3B",
                "terminal.ansi.green": "#EBA729",
                "terminal.ansi.yellow": "#FAE70E",
                "terminal.ansi.blue": "#F3CC20",
                "terminal.ansi.magenta": "#EC9B69",
                "terminal.ansi.cyan": "#D272CA",
                "terminal.ansi.white": "#c4c1c1",
                "terminal.ansi.bright_black": "#6b5858",
                "terminal.ansi.bright_red": "#B3BA3B",
                "terminal.ansi.bright_green": "#EBA729",
                "terminal.ansi.bright_yellow": "#FAE70E",
                "terminal.ansi.bright_blue": "#F3CC20",
                "terminal.ansi.bright_magenta": "#EC9B69",
                "terminal.ansi.bright_cyan": "#D272CA",
                "terminal.ansi.bright_white": "#c4c1c1",
                "modified": "#B3BA3B",
                "syntax": {
                    "attribute": {
                        "color": "#B3BA3B"
                    },
                    "boolean": {
                      "color": "#EBA729"
                    },
                    "comment": {
                      "color": "#6b5858"
                    },
                    "comment.doc": {
                      "color": "#6b5858"
                    },
                    "constant": {
                      "color": "#EBA729"
                    },
                    "function": {
                      "color": "#D272CA"
                    },
                    "keyword": {
                      "color": "#F3CC20"
                    },
                    "number": {
                      "color": "#EC9B69"
                    },
                    "operator": {
                      "color": "#F3CC20"
                    },
                    "string": {
                      "color": "#B3BA3B"
                    },
                    "variable": {
                      "color": "#EBA729"
                    }
                },
                "players": [
                  {
                    "cursor": "#B3BA3B",
                    "background": "#140808",
                    "selection": "#B3BA3B30"
                  }
                ]
            }
        }
    ]
}
