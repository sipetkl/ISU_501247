! X colors.
! Generated by 'wal'
*foreground:        #c5c5c4
*background:        #181716
*.foreground:       #c5c5c4
*.background:       #181716
emacs*foreground:   #c5c5c4
emacs*background:   #181716
URxvt*foreground:   #c5c5c4
XTerm*foreground:   #c5c5c4
UXTerm*foreground:  #c5c5c4
URxvt*background:   [100]#181716
XTerm*background:   #181716
UXTerm*background:  #181716
URxvt*cursorColor:  #c5c5c4
XTerm*cursorColor:  #c5c5c4
UXTerm*cursorColor: #c5c5c4
URxvt*borderColor:  [100]#181716

! Colors 0-15.
*.color0: #181716
*color0:  #181716
*.color1: #719571
*color1:  #719571
*.color2: #A39565
*color2:  #A39565
*.color3: #D4A85E
*color3:  #D4A85E
*.color4: #DFBE63
*color4:  #DFBE63
*.color5: #2D6E8F
*color5:  #2D6E8F
*.color6: #8A7182
*color6:  #8A7182
*.color7: #c5c5c4
*color7:  #c5c5c4
*.color8: #71715d
*color8:  #71715d
*.color9: #719571
*color9:  #719571
*.color10: #A39565
*color10:  #A39565
*.color11: #D4A85E
*color11:  #D4A85E
*.color12: #DFBE63
*color12:  #DFBE63
*.color13: #2D6E8F
*color13:  #2D6E8F
*.color14: #8A7182
*color14:  #8A7182
*.color15: #c5c5c4
*color15:  #c5c5c4

! Black color that will not be affected by bold highlighting.
*.color66: #181716
*color66:  #181716

! Xclock colors.
XClock*foreground: #c5c5c4
XClock*background: #181716
XClock*majorColor:  rgba:c5/c5/c4/ff
XClock*minorColor:  rgba:c5/c5/c4/ff
XClock*hourColor:   rgba:c5/c5/c4/ff
XClock*minuteColor: rgba:c5/c5/c4/ff
XClock*secondColor: rgba:c5/c5/c4/ff

! Set depth to make transparency work.
URxvt*depth: 32
