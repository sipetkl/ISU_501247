! X colors.
! Generated by 'wal'
*foreground:        #c4c1c1
*background:        #140808
*.foreground:       #c4c1c1
*.background:       #140808
emacs*foreground:   #c4c1c1
emacs*background:   #140808
URxvt*foreground:   #c4c1c1
XTerm*foreground:   #c4c1c1
UXTerm*foreground:  #c4c1c1
URxvt*background:   [100]#140808
XTerm*background:   #140808
UXTerm*background:  #140808
URxvt*cursorColor:  #c4c1c1
XTerm*cursorColor:  #c4c1c1
UXTerm*cursorColor: #c4c1c1
URxvt*borderColor:  [100]#140808

! Colors 0-15.
*.color0: #140808
*color0:  #140808
*.color1: #B3BA3B
*color1:  #B3BA3B
*.color2: #EBA729
*color2:  #EBA729
*.color3: #FAE70E
*color3:  #FAE70E
*.color4: #F3CC20
*color4:  #F3CC20
*.color5: #EC9B69
*color5:  #EC9B69
*.color6: #D272CA
*color6:  #D272CA
*.color7: #c4c1c1
*color7:  #c4c1c1
*.color8: #6b5858
*color8:  #6b5858
*.color9: #B3BA3B
*color9:  #B3BA3B
*.color10: #EBA729
*color10:  #EBA729
*.color11: #FAE70E
*color11:  #FAE70E
*.color12: #F3CC20
*color12:  #F3CC20
*.color13: #EC9B69
*color13:  #EC9B69
*.color14: #D272CA
*color14:  #D272CA
*.color15: #c4c1c1
*color15:  #c4c1c1

! Black color that will not be affected by bold highlighting.
*.color66: #140808
*color66:  #140808

! Xclock colors.
XClock*foreground: #c4c1c1
XClock*background: #140808
XClock*majorColor:  rgba:c4/c1/c1/ff
XClock*minorColor:  rgba:c4/c1/c1/ff
XClock*hourColor:   rgba:c4/c1/c1/ff
XClock*minuteColor: rgba:c4/c1/c1/ff
XClock*secondColor: rgba:c4/c1/c1/ff

! Set depth to make transparency work.
URxvt*depth: 32
